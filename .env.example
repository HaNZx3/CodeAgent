# 复制本文件为 .env，并填入你自己的值（.env 已被 .gitignore 忽略，不会进入仓库）。
# 变量名与环境变量完全一致；shell 中已 export 的变量优先级更高。

# OpenAI 兼容 API Key（OpenAI / DeepSeek / Qwen 等）
OPENAI_API_KEY=

# 使用 DeepSeek 时取消注释下面两行（示例）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# 可选：覆盖工作目录与运行限制
# CODING_AGENT_WORKSPACE=./demo
# CODING_AGENT_MAX_STEPS=20
# CODING_AGENT_MAX_RUNTIME=300
# CODING_AGENT_MAX_ERRORS=3
# CODING_AGENT_MAX_TOOL_OUTPUT=8192
# CODING_AGENT_COMMAND_TIMEOUT=30
