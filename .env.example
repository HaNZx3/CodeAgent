# Coding Agent 配置示例。
# 复制为 .env 并填入值；真实凭据建议放全局位置（见下方说明）。

# ===== 凭据存放位置 =====
# 推荐放全局，任意目录启动都能读到：
#   Windows: %USERPROFILE%\.coding-agent\.env
#   Linux/Mac: ~/.coding-agent/.env
# 项目根 .env 可临时覆盖全局配置（优先级更高）。
# 优先级：shell 环境变量 > 当前目录 .env > 项目根 .env > 全局 ~/.coding-agent/.env

# OpenAI 兼容 API Key（OpenAI / DeepSeek / Qwen / GLM 等）
OPENAI_API_KEY=

# 使用 GLM（智谱）免费模型：https://open.bigmodel.cn/apiToken 创建 Key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.7-flash

# 使用 DeepSeek 时换成下面两行（示例）
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# ===== 工作目录 =====
# 不设 CODING_AGENT_WORKSPACE 且不传 --workspace 时，默认绑定当前工作目录（cwd），
# 像 Claude Code 一样在任意文件夹启动。设为固定路径则锁定该目录。
# CODING_AGENT_WORKSPACE=./demo

# 可选：运行限制
# CODING_AGENT_MAX_STEPS=20
# CODING_AGENT_MAX_RUNTIME=300
# CODING_AGENT_MAX_ERRORS=3
# CODING_AGENT_MAX_TOOL_OUTPUT=8192
# CODING_AGENT_COMMAND_TIMEOUT=30

# ===== 上下文压缩 =====
# 上次 API 返回的真实 prompt_tokens 超过此值时自动压缩历史
# CODING_AGENT_COMPACT_THRESHOLD=80000
# 压缩时保留最近多少轮对话（一轮 = user + 后续 assistant/tool）
# CODING_AGENT_KEEP_RECENT=6

# ===== 会话持久化 =====
# 会话文件根目录，空则用 ~/.coding-agent/sessions
# CODING_AGENT_SESSION_ROOT=
